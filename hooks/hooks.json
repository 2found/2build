{
  "description": "Babysit release checks, session tracking, and Orca worker stop checks. OMP uses hooks/omp.ts.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bbs hooks pre-tool-gate", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bbs hooks session-writer", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bbs hooks worker-report-gate", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bbs hooks session-writer", "timeout": 10 }
        ]
      }
    ]
  }
}
